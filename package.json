{
  "name": "APKScc",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "predev": "node scripts/generate-sitemap.mjs --prune-public",
    "dev": "node scripts/set-console-title.mjs \"AC-GameVerse dev :9002\" && node scripts/next-runner.mjs dev",
    "prebuild": "node scripts/preflight-capacity.mjs && node scripts/generate-sitemap.mjs",
    "build": "next build",
    "postbuild": "node scripts/generate-sitemap.mjs --stage-next",
    "start": "node scripts/next-runner.mjs start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "contract:check": "node scripts/check-api-contract.mjs",
    "contract:sync": "node scripts/sync-api-contract.mjs",
    "test:markdown": "node --test tests/markdown-render.test.cjs",
    "test:home-feed": "node --test tests/home-post-author-cap.test.mjs",
    "test:breadcrumbs": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/breadcrumbs.test.mjs",
    "test:seo-runner": "node --test tests/seo-write-game.test.mjs tests/seo-indexnow-boundary.test.mjs tests/deploy-fast-boundary.test.mjs",
    "test:game-detail": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/game-detail-boundary.test.mjs tests/image-preview.test.mjs tests/seo-template.test.mjs tests/game-detail-resilience.test.mjs tests/game-download-route.test.mjs tests/game-detail-similar-games.test.mjs",
    "test:game-review": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./tests/helpers/alias-loader.mjs --test tests/game-review-offline.test.mjs",
    "test:game-description": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./tests/helpers/alias-loader.mjs --test tests/game-description-markdown.test.mjs",
    "test:game-description-sanitize": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./tests/helpers/alias-loader.mjs --test tests/game-description-sanitize.test.mjs",
    "test:game-display-name": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/game-display-name.test.mjs",
    "test:authed-fetch": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./tests/helpers/alias-loader.mjs --test tests/authed-fetch.test.mjs",
    "test:route-template": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/route-template.test.mjs",
    "test:screen-view": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./tests/helpers/alias-loader.mjs --test tests/screen-view-props.test.mjs",
    "test:sitemap": "node --test tests/sitemap-static.test.mjs tests/category-pages.test.mjs",
    "test:edge-cache": "node --test tests/edge-cache-rule.test.mjs tests/html-vary.test.mjs tests/next-prod-server.test.mjs",
    "test:api-proxy-guard": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/api-proxy-guard.test.mjs",
    "test:auth": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./tests/helpers/alias-loader.mjs --test tests/auth-errors.test.mjs tests/auth-session.test.mjs",
    "test:api-timeout": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./tests/helpers/src-loader.mjs --test tests/api-timeout.test.mjs",
    "test:client-errors": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./tests/helpers/alias-loader.mjs --test tests/client-errors.test.mjs",
    "test:error-boundary": "node --test tests/error-boundary.test.mjs",
    "test:resource-signature": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/resource-signature.test.mjs",
    "test:my-downloads": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./tests/helpers/alias-loader.mjs --test tests/my-downloads.test.mjs",
    "test:download-error": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./tests/helpers/alias-loader.mjs --test tests/download-error-notice.test.mjs",
    "test:content-report": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./tests/helpers/alias-loader.mjs --test tests/content-report.test.mjs",
    "test:site-config": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./tests/helpers/react-cache-stub-loader.mjs --import ./tests/helpers/alias-loader.mjs --test tests/site-config-cache-poison.test.mjs",
    "test:community-feed": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./tests/helpers/alias-loader.mjs --test tests/community-feed-status.test.mjs",
    "test:route-identifier": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./tests/helpers/react-cache-stub-loader.mjs --import ./tests/helpers/alias-loader.mjs --test tests/route-identifier.test.mjs",
    "test:a11y": "node --test tests/a11y-guard.test.mjs",
    "seo:audit": "node scripts/seo-daily-audit.mjs",
    "seo:write-game": "node scripts/seo-write-game.mjs",
    "preinstall": "node -e \"const ua=process.env.npm_config_user_agent||'';if(ua.indexOf('pnpm/')!==0){console.error('[preinstall] 本项目只允许使用 pnpm 安装依赖，请改用 pnpm install');process.exit(1)}\"",
    "assert:build-env": "node scripts/assert-build-env.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^4.1.3",
    "@radix-ui/react-accordion": "^1.2.3",
    "@radix-ui/react-alert-dialog": "^1.1.6",
    "@radix-ui/react-avatar": "^1.1.3",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-menubar": "^1.1.6",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-progress": "^1.1.2",
    "@radix-ui/react-radio-group": "^1.2.3",
    "@radix-ui/react-scroll-area": "^1.2.3",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slider": "^1.2.3",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-toast": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.1.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "dotenv": "^16.5.0",
    "geist": "^1.3.1",
    "isomorphic-dompurify": "^4.6.0",
    "lucide-react": "^0.475.0",
    "next": "15.5.28",
    "next-themes": "^0.3.0",
    "nprogress": "^0.2.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-day-picker": "^8.10.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.2",
    "recharts": "^2.15.1",
    "tailwind-merge": "^3.0.1",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/nprogress": "^0.2.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.5.28",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
