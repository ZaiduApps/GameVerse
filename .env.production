# 生产构建环境（入库文件，只放会内联进客户端包的公开值，不含任何密钥）
#
# 为什么需要它：发布流程在本机构建 pnpm build，只把 .next 上传到服务器，
# 服务器从不构建；而 NEXT_PUBLIC_* 是构建期写死进客户端包的常量，
# 服务器上的 .env 改不了它。若构建时用的是本机开发 .env，
# 线上浏览器的 API 基址会被静默改掉（2026-09-11 实测发生过）。
#
# 加载优先级（next build，NODE_ENV=production）：
#   .env.production.local > .env.local > .env.production > .env
# next dev（NODE_ENV=development）不会加载本文件，本机开发仍走 .env。
#
# 校验：pnpm assert:build-env（发布脚本在 gameverse 构建后自动执行）
APP_ENV=production
PORT=3002
# 服务端/SSR 走本机接口；同时决定 next.config.ts 的 /api rewrites 目标
API_BASE_URL=http://127.0.0.1:9527
# 浏览器直连接口（NEXT_PUBLIC_API_USE_PROXY=false 时生效）
NEXT_PUBLIC_API_BASE_URL=https://api.hk.apks.cc
NEXT_PUBLIC_API_USE_PROXY=false
NEXT_PUBLIC_CLIENT_PLATFORM=android
NEXT_PUBLIC_CLIENT_REGION=
NEXT_PUBLIC_CLIENT_VERSION=1.0.0
NEXT_PUBLIC_SITE_STYLE=magazine
HOME_DYNAMIC_COUNT=8
SITE_CONFIG_KEY=main
GAME_DETAIL_PREBUILD_LIMIT=100
